# Inside the radioindex-blog image. TLS and compression stay in the host Caddy that proxies to this port.
{
	auto_https off
	admin off
}
:8891 {
	root * /srv
	log {
		output stdout
		format json
	}
	header Cache-Control "public, max-age=300, s-maxage=86400, stale-while-revalidate=86400"
	# the Worker trimmed trailing slashes, answered /health, and redirected /<slug> to /posts/<slug>
	@trail path_regexp trail ^/(.+)/$
	redir @trail /{re.trail.1} 301
	@health path /health
	rewrite @health /health.json
	@shortmd path_regexp shortmd ^/(20[0-9]{2}-[0-9]{2}-[0-9]{2}-[^/]+)\.md$
	rewrite @shortmd /posts/{re.shortmd.1}.md
	@short path_regexp short ^/(20[0-9]{2}-[0-9]{2}-[0-9]{2}-[^/.]+)$
	redir @short /posts/{re.short.1} 301
	@md path *.md
	header @md Content-Type "text/markdown; charset=utf-8"
	@xml path *.xml
	header @xml Content-Type "application/xml; charset=utf-8"
	@jsonfeed path /feed.json
	header @jsonfeed Content-Type "application/feed+json; charset=utf-8"
	try_files {path} {path}/index.html
	file_server
	handle_errors {
		header Content-Type "text/html; charset=utf-8"
		respond `<h1>404 Not Found</h1><p><a href="/">Return to blog home</a></p>` 404
	}
}
