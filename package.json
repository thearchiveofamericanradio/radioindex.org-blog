{
  "name": "radioindex-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run papers && tsx scripts/build-posts.ts && tsc --noEmit",
    "dev": "tsx scripts/build-posts.ts && wrangler dev",
    "deploy": "tsx scripts/build-posts.ts && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "voa": "node scripts/voa-lint.mjs",
    "paper:ingest": "node scripts/paper-ingest.mjs",
    "paper:build": "node scripts/paper-build.mjs",
    "papers": "node scripts/paper-build.mjs papers/dating-undated.xml voa posts/2026-09-02-dating-the-undated.md && node scripts/paper-build.mjs papers/dating-undated.xml awl posts/2026-09-02-register-awl.md"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^22.13.4",
    "marked": "^18.0.10",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "wrangler": "^4.125.0"
  }
}